# ── Temporal ─────────────────────────────────────────────────────────────
# Address of the Temporal server this worker polls. Against Temporal Cloud,
# the PrivateLink-routed namespace address infrastructure/constructs/
# temporal-namespace.ts's outputs expose; locally, the compose service name
# (e.g. temporal:7233).
TEMPORAL_HOST=

# The namespace's fully-qualified id against Temporal Cloud (base name plus
# account-id suffix Temporal assigns at creation — not the plain name you
# chose); against a local dev server, whatever namespace temporalio/
# auto-setup registered (default "default").
TEMPORAL_NAMESPACE=

# Must match webhook-listener's TEMPORAL_TASK_QUEUE exactly, or a workflow it
# starts has no worker polling for it.
TEMPORAL_TASK_QUEUE=

# Temporal Cloud API key for this namespace's service account. Leave unset
# for a local dev server (temporalio/auto-setup has no namespace auth at
# all) — a missing key is a real, valid state here, not a misconfiguration.
TEMPORAL_API_KEY=

# Defaults true (Temporal Cloud requires TLS). Set to the literal string
# "false" only for a local dev server, which runs without it.
TEMPORAL_TLS=

# ── Specialist dispatch target ──────────────────────────────────────────────
# From specialist-sandbox's clusterArn output (real AWS), or the cluster the
# LocalStack bootstrap script registers (local dev — see
# docs/local-development.md).
SPECIALIST_CLUSTER_ARN=

# From specialist-sandbox's taskDefinitionArn output, or the LocalStack
# bootstrap script's registered task definition.
SPECIALIST_TASK_DEFINITION_ARN=

# From specialist-sandbox's taskDefinitionFamily output — identical to the
# container name by construction (specialist-task.ts derives both from
# formatName(config.name)).
SPECIALIST_CONTAINER_NAME=

# From specialist-sandbox's securityGroupId output, or a dummy LocalStack one.
SPECIALIST_SECURITY_GROUP_ID=

# Comma-separated. From network's publicSubnetIds output, or dummy LocalStack
# subnet ids.
SPECIALIST_SUBNET_IDS=

# ── AWS (ecs:RunTask/DescribeTasks) ─────────────────────────────────────────
# Real AWS: leave all four unset — the SDK's own default credential/region
# chain and default endpoints apply. Local dev against LocalStack: set
# AWS_ENDPOINT_URL to the compose service (e.g. http://localstack:4566) and
# the two key vars to LocalStack's documented placeholder ("test"/"test") —
# confirmed the installed @aws-sdk/client-ecs respects AWS_ENDPOINT_URL
# natively, no code change needed for this.
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# ── GitHub / Linear ──────────────────────────────────────────────────────────
# Used directly (branch creation, PR lookup, tracker reads/writes) — not an
# MCP connector here, unlike webhook-listener/specialist-runner.
GITHUB_TOKEN=
LINEAR_AGENT_API_KEY=

# GraphQL endpoint for the Linear API.
# Default (if unset): https://api.linear.app/graphql
LINEAR_API_URL=

# ── Reviewer-of-record ───────────────────────────────────────────────────────
# Static, architect-maintained JSON object mapping a story-mover's Linear
# email to their GitHub login — GitHub's requested-reviewers API needs a
# login, Linear only gives us an email. Optional: unset, or missing an entry
# for a given mover, just skips requesting a reviewer for that dispatch rather
# than failing it. Example: {"user@example.com":"example-login"}
REVIEWER_EMAIL_TO_GITHUB_LOGIN=

# ── Worker ──────────────────────────────────────────────────────────────────
# Log verbosity threshold: trace | debug | info | warn | error. Default (if
# unset): info. Only covers worker.ts's own startup/shutdown lines — activity
# and workflow code logs through Temporal's own sink instead (see logger.ts).
LOG_LEVEL=

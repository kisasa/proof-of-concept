# ── Linear ────────────────────────────────────────────────────────────────
# Signing secret shown when you create the webhook in Linear (Settings → API → Webhooks).
LINEAR_WEBHOOK_SECRET=

# API key for the bot user every lane acts as. Used by the Linear adapter to
# resolve entity context (status/labels/title) for comment events, and as the
# MCP connector's auth token so Claude can read/write the tracker directly
# during a run. (Settings → API → Personal API keys, created while logged in
# as the bot account.)
LINEAR_AGENT_API_KEY=

# GraphQL endpoint for the Linear API.
# Default (if unset): https://api.linear.app/graphql
LINEAR_API_URL=

# Linear's hosted remote MCP server. VERIFY the URL and auth mechanism against
# Linear's current MCP docs before deploying — this may require OAuth rather
# than a personal API key bearer token.
# Default (if unset): https://mcp.linear.app/mcp
LINEAR_MCP_URL=

# The bot user's Linear id. Comments authored by this id are ignored by
# routing's self-comment guard — this is what stops an agent from re-waking
# itself on its own comment (label changes, an agent's handoff mechanism
# between lanes, are never guarded).
AGENT_USER_ID=

# ── Worker ──────────────────────────────────────────────────────────────────
PORT=8787

# Coalesce bursts of human comments into one agent run (milliseconds).
DEBOUNCE_MS=15000

# Staged dry run for standing the pipeline up incrementally: unset runs the
# full pipeline; "accept" stops right after a webhook is verified, deduped,
# and parsed, before routing runs (the response echoes the parsed event).
# More stages ("route", "prompt") land as the later rungs are built.
TEST_STAGE=

# Log verbosity threshold: trace | debug | info | warn | error. trace shows
# every decision and move in one webhook delivery and whatever activation it
# causes (very verbose — grep the per-delivery id logged as
# "[scope:traceId]" to follow one request end to end); debug adds per-run
# token counts and routine "no-fire" routing decisions. Unrecognized values
# fall back to info. Default (if unset): info.
LOG_LEVEL=

# ── GitHub ───────────────────────────────────────────────────────────────────
# GitHub's hosted remote MCP server, attached (alongside Linear's) for
# Specification and Decompose so Claude reads the product codebase directly —
# the app never clones or reads a repo itself. VERIFY the URL and auth
# mechanism against GitHub's current MCP docs before deploying; this may
# require OAuth rather than a personal access token bearer.
# Default (if unset): https://api.githubcopilot.com/mcp/
GITHUB_MCP_URL=

# Fine-grained PAT (Contents: Read) used as the GitHub MCP connector's auth
# token. If unset, Specification and Decompose reason from the tracker +
# product context alone, with no codebase access.
GITHUB_TOKEN=

# ── Agent ────────────────────────────────────────────────────────────────────
# Anthropic key used by every lane's activation run.
ANTHROPIC_API_KEY=

# Optional: comma-separated files of product context (briefs, prior decisions)
# folded into every lane's activation prompt.
PRODUCT_CONTEXT_PATHS=

# Required — no code-level default. Per-lane model, infra-tunable per
# engagement (see infrastructure/models/listener-configuration.ts).
CLAUDE_MODEL_INTAKE=
CLAUDE_MODEL_SPECIFICATION=
CLAUDE_MODEL_DECOMPOSE=

# Required — no code-level default. low | medium | high | xhigh | max.
# Uniform across every lane's activation call (see activation-config.ts).
CLAUDE_EFFORT=

# ── Temporal (specialist-dispatch lane only) ────────────────────────────────
# Connection info for the temporal-workers stack's namespace — this process
# only starts workflows (@temporalio/client), it never executes one. All five
# read lazily: a webhook-listener deployed before temporal-workers exists
# still routes Intake/Specification/Decompose without crashing at startup.
# PrivateLink-routed namespace address, e.g. <namespace-id>.tmprl.cloud:7233;
# locally, the compose service name (e.g. temporal:7233).
TEMPORAL_HOST=

# The namespace's fully-qualified id (base name + account-id suffix Temporal
# assigns at creation), not the plain namespace-name you chose. Against a
# local dev server, whatever temporalio/auto-setup registered (default
# "default").
TEMPORAL_NAMESPACE=

# Must match temporal-workers's own task queue exactly, or a started workflow
# has no worker polling for it.
TEMPORAL_TASK_QUEUE=

# Temporal Cloud API key for this namespace's service account. Leave unset
# for a local dev server (no namespace auth at all) — a missing key is a
# real, valid state, not a misconfiguration.
TEMPORAL_API_KEY=

# Defaults true (Temporal Cloud requires TLS). Set to the literal string
# "false" only for a local dev server, which runs without it.
TEMPORAL_TLS=

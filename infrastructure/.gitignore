node_modules/

# Synthesized Terraform JSON. Regenerated by `cdktn synth` from the .ts sources,
# which are the source of truth.
cdktn.out/
*.cdktn.out/

# Only present if we ever fall back from the prebuilt @cdktn/provider-aws
# package to locally generated bindings via `cdktn get`.
.gen/

# Local Terraform working state. Real state lives in the S3 backend.
.terraform/
*.tfstate
*.tfstate.*

# There should be nothing to put here — secrets reach the container from SSM,
# never through a Terraform variable. Ignored so an experiment can't leak.
*.tfvars

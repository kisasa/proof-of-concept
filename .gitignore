# Real secret values for the local dev stack — copy from
# docker-compose.override.yml.example, never commit the filled-in copy.
docker-compose.override.yml

# Deployment-specific CDKTN config — copy from infrastructure/cdktf.example.json
# and fill in your own account, bucket, domain, SSM prefix and reviewer table.
# Never commit the filled-in copy: it is one deployment's identity, not
# framework material, and it is the file every private-reference sweep kept
# tripping over.
infrastructure/cdktf.json
infrastructure/cdktf.*.json
scripts/__pycache__/

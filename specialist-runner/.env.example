# specialist-runner has no persistent .env file in production — every var
# below is set as an ecs:RunTask container override, per-dispatch, by
# dispatch-worker/src/activities/dispatch-specialist.ts. This file exists so
# you can run the image standalone for local testing:
#   docker run --env-file specialist-runner/.env specialist-runner:local
# (fill in the required values first — see docs/local-development.md).

# ── This dispatch's identity (normally set by dispatch-specialist.ts) ──────
STORY_ID=
STORY_TITLE=
EPIC_ID=

# Comma-separated surface:<name> label(s) the story carries, e.g. backend or web,e2e.
SURFACES=

# org/name on GitHub — the one repo this run writes to.
SURFACE_REPO=

# Optional, from the surface registry. Comma-separated directory per surface
# in the same order as SURFACES ("/" for the repo root); defaults to "/" each.
SURFACE_PATHS=
# Optional, from the surface registry. Comma-separated mandatory skills,
# resolved from the surface repo's .claude/skills/ first, then the framework.
SURFACE_SKILLS=

# Branch names the tracker already assigned (gitBranchName).
STORY_BRANCH=
EPIC_BRANCH=

# Hard cap on Agent SDK turns — a session doesn't time out on its own.
MAX_TURNS=

# ── Revision round (set by the dispatcher only when answering a review) ──────
# All four travel together or not at all. Their absence is what tells this
# runner it is doing a story's first build rather than revising an open PR;
# a partial set is refused rather than guessed at. The review's text is
# deliberately not passed — the specialist reads it from the PR itself.
REVISION_ROUND=
REVISION_ROUND_CAP=
PULL_REQUEST_NUMBER=
REVIEW_ID=

# ── Framework clone (cloned fresh every run, never baked into the image) ───
# Default (if unset): example-org/intent-to-production
FRAMEWORK_REPO=
# Default (if unset): main
FRAMEWORK_REF=

# ── Claude ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Required — no code-level default. In production these two are baked into
# the task definition's baseline environment by infrastructure/stacks/
# specialist-sandbox.ts (context keys specialist-sandbox.claude-model /
# .claude-effort), not set per-dispatch — tune them there to change every
# specialist run in a deployment.
CLAUDE_MODEL=

# Required — no code-level default. low | medium | high | xhigh | max.
CLAUDE_EFFORT=

# ── Tracker / source control (Linear + GitHub MCP servers) ──────────────────
LINEAR_AGENT_API_KEY=
GITHUB_TOKEN=

# Default (if unset): https://mcp.linear.app/mcp
LINEAR_MCP_URL=
# Default (if unset): https://api.githubcopilot.com/mcp/
GITHUB_MCP_URL=
# Used only by tracker-fallback.ts's direct write, not the MCP connector.
# Default (if unset): https://api.linear.app/graphql
LINEAR_API_URL=

# ── Worker ──────────────────────────────────────────────────────────────────
# Log verbosity threshold: trace | debug | info | warn | error. Default (if
# unset): info.
LOG_LEVEL=
